# Environment variables for Code Auto-Grader

# Gemini API Key (Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=5000

# Code Execution Configuration
# Maximum number of concurrent code executions (default: 15)
# Tune based on your server resources (CPU cores, memory)
# Formula: min(CPU_CORES * 2, TOTAL_MEMORY_GB / 0.5) * 0.75
MAX_CONCURRENT_EXECUTIONS=15

# Timeout for waiting in execution queue (default: 10s)
# Users will see "server busy" error if they wait longer than this
# Format: duration string (e.g., "10s", "30s", "1m")
EXECUTION_QUEUE_TIMEOUT=10s
