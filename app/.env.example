# Environment variables for Code Auto-Grader
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
ENVIRONMENT=development

# =============================================================================
# Database Configuration
# =============================================================================
# These atomic parts are used by Docker Compose, Makefile, and the Go app.
# This is the single source of truth for database configuration.

DB_USER=code_grader
DB_PASSWORD=dev_password_change_in_production
DB_HOST=localhost
DB_PORT=5442
DB_NAME=code_auto_grader
DB_SSLMODE=disable

# Test Database (isolated from development, uses in-memory storage)
TEST_DB_USER=code_grader
TEST_DB_PASSWORD=test_password
TEST_DB_HOST=localhost
TEST_DB_PORT=5443
TEST_DB_NAME=code_auto_grader_test

# =============================================================================
# Migration Settings
# =============================================================================
# Auto-run migrations on startup (optional, default: true)
DB_AUTO_MIGRATE=true

# Path to migration files (optional, default: file://migrations)
DB_MIGRATIONS_PATH=file://migrations

# =============================================================================
# External Services
# =============================================================================
# Gemini API Key (Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Code Execution Configuration
# =============================================================================
# Maximum number of concurrent code executions (default: 15)
# Tune based on your server resources (CPU cores, memory)
MAX_CONCURRENT_EXECUTIONS=15

# Timeout for waiting in execution queue (default: 10s)
# Users will see "server busy" error if they wait longer than this
EXECUTION_QUEUE_TIMEOUT=10s

# Language-specific container pool sizes
JS_POOL_SIZE=5
PY_POOL_SIZE=5
RUST_POOL_SIZE=2
